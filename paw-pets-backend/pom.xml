<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- POM = Project Object Model: el archivo de Maven que describe el proyecto Java del backend, sus dependencias y cómo se compila. -->
    <modelVersion>4.0.0</modelVersion>

    <!-- Misma versión de Spring Boot que los proyectos de ejemplo del profesor -->
    <!-- El "parent" aporta versiones compatibles de todas las librerías de Spring (por eso la mayoría de dependencias no llevan versión). -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <!-- Identidad del proyecto: groupId (organización) + artifactId (nombre) + version = coordenadas únicas del artefacto. -->
    <groupId>cl.duoc</groupId>
    <artifactId>paw-pets-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>paw-pets-backend</name>
    <description>API REST de la tienda PawPets (Spring Boot + MongoDB Atlas + JWT)</description>

    <properties>
        <!-- Java 17, igual que BackendMongoSitioFull del profesor -->
        <!-- Versión de Java usada para compilar. -->
        <java.version>17</java.version>
    </properties>

    <!-- Librerías externas que Maven descarga automáticamente de Maven Central. Cada "starter" de Spring Boot agrupa varias librerías relacionadas. -->
    <dependencies>
        <!-- API REST (controladores, JSON) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- Conexión a MongoDB (local o Atlas) con Spring Data -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>
        <!-- Validación de datos de entrada (@NotBlank, @Min, @Email...) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Seguridad: autenticación, roles y BCrypt -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Tokens JWT: firma y verificación (Nimbus JOSE) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>
        <!-- Swagger UI / OpenAPI (misma versión que el ejemplo del profesor) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.2.0</version>
        </dependency>
        <!-- Lombok: genera getters y setters al compilar -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <!-- scope provided: Lombok solo se necesita al COMPILAR (genera getters/setters); no se incluye en el .jar final. -->
            <scope>provided</scope>
        </dependency>
        <!-- Pruebas unitarias: JUnit 5 + Mockito -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <!-- scope test: solo existe al ejecutar las pruebas; no viaja a producción. -->
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Sección de construcción: plugins que Maven ejecuta al compilar, probar y empaquetar. -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <!-- Compilador. Aquí se le indica que use Lombok como procesador de anotaciones (para que genere los getters/setters). -->
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <!-- Permite ejecutar la app con "mvnw spring-boot:run" y empaquetarla como un .jar ejecutable. -->
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- JaCoCo: mide la cobertura de las pruebas. Reporte en target/site/jacoco/index.html -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.14</version>
                <executions>
                    <execution>
                        <id>preparar-agente</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>reporte</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
