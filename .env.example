# Copia este archivo como .env (en esta misma carpeta, junto al pom.xml) y reemplaza los valores.
# El archivo .env está en .gitignore: NUNCA se sube al repositorio.

# URI de MongoDB Atlas (Database > Connect > Drivers). Agrega el nombre de la base (/pawpets) antes del "?".
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/pawpets?retryWrites=true&w=majority

# Frase secreta para firmar los JWT (mínimo 32 caracteres, sin compartirla)
JWT_SECRET=cambia-esta-frase-por-una-larga-y-secreta-de-32-o-mas-caracteres

# Origen del frontend (Vite)
CORS_ORIGIN=http://localhost:5173
